---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Contact | fmlaviolationcalc.com';
const description = 'Contact the fmlaviolationcalc.com editorial team with corrections, feedback, or questions.';
---
<BaseLayout title={title} description={description}>
  <h1>Contact</h1>
  <p>For corrections, feedback, or questions about the calculator or guides, email <a href="mailto:hey@theclicklab.agency">hey@theclicklab.agency</a>.</p>
  <p>We read every message and take accuracy reports seriously. If you believe a legal reference is outdated, a calculation result appears incorrect, or a regulatory citation has changed, please include the specific page URL and the detail you believe is wrong. We review and correct confirmed errors promptly.</p>
  <p>We are not able to provide legal advice, evaluate your specific FMLA situation, or advise on whether a particular employer action constitutes a violation. If you believe your FMLA rights have been violated, please consult a licensed employment attorney in your state. Many employment attorneys handle FMLA retaliation and interference cases on contingency — no fee unless you recover — making legal representation accessible regardless of your current financial situation.</p>
</BaseLayout>
